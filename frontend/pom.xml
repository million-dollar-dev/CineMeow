<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cinemeow</groupId>
        <artifactId>cinemeow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>frontend</artifactId>
    <packaging>pom</packaging>
    <name>Frontend Modules</name>

    <properties>
        <node.version>v20.18.0</node.version>
        <npm.version>10.8.2</npm.version>
        <frontend-maven-plugin.version>1.15.1</frontend-maven-plugin.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <npmVersion>${npm.version}</npmVersion>
                    <installDirectory>${project.basedir}</installDirectory>
                </configuration>

                <executions>
                    <!-- 1. Tự động tải và cài đặt Node.js & NPM cục bộ (không cần cài vào máy) -->
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                    </execution>

                    <!-- 2. Cài đặt dependencies cho admin-frontend -->
                    <execution>
                        <id>npm-install-admin</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <workingDirectory>admin-frontend</workingDirectory>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- 3. Build admin-frontend -->
                    <execution>
                        <id>npm-build-admin</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <workingDirectory>admin-frontend</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>

                    <!-- 4. Cài đặt dependencies cho client-frontend -->
                    <execution>
                        <id>npm-install-client</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <workingDirectory>client-frontend</workingDirectory>
                            <arguments>install</arguments>
                        </configuration>
                    </execution>

                    <!-- 5. Build client-frontend -->
                    <execution>
                        <id>npm-build-client</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>compile</phase>
                        <configuration>
                            <workingDirectory>client-frontend</workingDirectory>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
